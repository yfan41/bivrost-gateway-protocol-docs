# Upstream provider: "anthropic" (default) or "deepseek".
# deepseek uses DeepSeek's Anthropic-compatible API (api.deepseek.com/anthropic).
#AI_PROVIDER=deepseek

# Anthropic API key (required unless AI_PROVIDER=deepseek)
ANTHROPIC_API_KEY=

# DeepSeek API key (required when AI_PROVIDER=deepseek)
#DEEPSEEK_API_KEY=

# Model override. Defaults: claude-opus-5 (anthropic) / deepseek-v4-pro (deepseek).
#AI_MODEL=

# Listen port (default 8787)
PORT=8787

# Listen address (default 127.0.0.1). Keep loopback in production so nginx is the
# only way in; set 0.0.0.0 only when running in a container/network namespace.
#HOST=127.0.0.1

# Docs corpus: set exactly one. File wins if both are set.
# Local build output (run `pnpm build` in the repo root first):
DOCS_LLMS_FILE=../../dist/llms-full.txt
# Or fetch from the live site at startup:
#DOCS_LLMS_URL=https://docs.bivrost.cn/gateway-protocol/llms-full.txt

# Optional: cap the corpus at N chars, cut at a page boundary (0/unset = full corpus).
# Recommended with deepseek: no prompt caching there, so every request pays full
# prefill; also avoids large-request stalls on some network paths.
#DOCS_CONTEXT_MAX_CHARS=80000

# Dev only: allow cross-origin requests from this origin (e.g. http://localhost:4321).
# Leave unset in production (same-origin behind nginx, no CORS needed).
#ALLOWED_ORIGIN=
