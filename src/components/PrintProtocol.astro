---
/**
 * The whole protocol reference as one document: every page in sidebar order,
 * merged, with heading ids de-collided and internal cross-references rewritten to
 * in-document anchors. Rendered by src/pages/print.astro and
 * src/pages/en/print.astro, and captured by scripts/generate-pdf.mjs.
 */
import { getCollection, render } from 'astro:content';
import {
  getSidebar,
  flattenSidebar,
  pickLabel,
  canonicalId,
  entryKeyFor,
  pathKeyFor,
} from '../sidebar.mjs';
import logo from '../assets/logo.png';
import '../styles/print-protocol.css';

interface Props {
  /** undefined for the root/简体中文 tree, 'en' under /en/. */
  locale: 'en' | undefined;
  version: string;
  /** Build date, passed in so the two locales stamp the same day. */
  date: string;
}

const { locale, version, date } = Astro.props;
const isEnglish = locale === 'en';

const chapters = flattenSidebar(getSidebar(version));
const entries = await getCollection('docs');
const byKey = new Map(entries.map((entry) => [canonicalId(entry.id), entry]));

const sections = [];
for (const chapter of chapters) {
  const key = entryKeyFor(chapter.slug, locale);
  const entry = byKey.get(key);
  // Fail the BUILD, not the PDF run. A chapter silently vanishing from the document
  // is the worst failure mode here, and a typo'd sidebar slug is how it happens.
  if (!entry) {
    throw new Error(`[print] no docs entry "${key}" for sidebar slug "${chapter.slug}"`);
  }

  // The page's own title is the chapter heading, except where the sidebar names the
  // node explicitly (see flattenSidebar).
  const heading = pickLabel(chapter.label, isEnglish) ?? entry.data.title;
  // A top-level group's label, printed only when the chapter opening the group is
  // not already named after it ('二、HTTP 通讯' is the title of http/index.md, so it
  // would print twice).
  const partText = pickLabel(chapter.part, isEnglish);

  const idKey = chapter.slug.replace(/\//g, '-');
  sections.push({
    slug: chapter.slug,
    heading,
    part: partText && partText !== heading ? partText : null,
    // Locale-qualified path, matching what the browser derives from an href:
    // /gateway-protocol/en/http/auth/ → 'en/http/auth'. Each tree's root
    // normalises to 'index' (简体中文) / 'en' (English).
    pathKey: pathKeyFor(chapter.slug, locale),
    sectionId: `sec-${idKey}`,
    // Locale-free, so the zh and en PDFs carry identical internal ids.
    idPrefix: `${idKey}--`,
    entry,
    Content: (await render(entry)).Content,
  });
}

// BASE_URL is '/' locally, '/gateway-protocol/' or '/gateway-protocol/v1.19.7/'
// in CI.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const linkMap = Object.fromEntries(
  sections.map(({ pathKey, sectionId, idPrefix }) => [pathKey, { sectionId, idPrefix }])
);

const printData = {
  base,
  // Where links that are not part of this PDF should point instead.
  site: 'https://docs.bivrost.cn/gateway-protocol',
  linkMap,
  expected: sections.length,
};
---

<div class="print-doc" data-pagefind-ignore>
  <section class="print-cover">
    <img src={logo.src} width={logo.width} height={logo.height} alt="Bivrost" />
    <h1 class="print-cover-title">
      {isEnglish ? 'Bivrost Gateway' : '彼络物联网关'}
    </h1>
    <p class="print-cover-sub">{isEnglish ? 'Communication Protocol' : '通讯协议'}</p>
    <p class="print-cover-meta">v{version} · {date}</p>
  </section>

  <nav class="print-toc" aria-label={isEnglish ? 'Contents' : '目录'}>
    <h1>{isEnglish ? 'Contents' : '目录'}</h1>
    <ol>
      {
        sections.map(({ sectionId, heading, part }) => (
          <>
            {part && (
              <li class="print-toc-part">
                <a href={`#${sectionId}`}>{part}</a>
              </li>
            )}
            <li>
              <a href={`#${sectionId}`}>{heading}</a>
            </li>
          </>
        ))
      }
    </ol>
  </nav>

  {
    sections.map(({ sectionId, slug, pathKey, idPrefix, heading, part, Content }) => (
      <section
        class="print-section"
        id={sectionId}
        data-slug={slug}
        data-path={pathKey}
        data-prefix={idPrefix}
      >
        {part && <p class="print-part-title">{part}</p>}
        <h1 class="print-section-title">{heading}</h1>
        <Content />
      </section>
    ))
  }
</div>

<script is:inline define:vars={{ printData }}>
  /*
   * Turn 29 separately-authored pages into one document:
   *   1. prefix every heading id per section so anchors stop colliding
   *   2. rewrite internal links to in-document #fragments so cross-references
   *      still work inside the PDF
   * Done in the DOM rather than at build time because the DOM is exactly what
   * Chromium prints, and because it is inspectable — open /print/ and click a link.
   */
  (() => {
    const { base, site, linkMap, expected } = printData;
    const sections = Array.from(document.querySelectorAll('section[data-slug]'));
    const stats = { sections: sections.length, expected, ids: 0, rewritten: 0, unresolved: [] };

    // 1. De-collide ids, remembering the old → new mapping per section so that
    //    same-page fragment links can be remapped too.
    const idMaps = new Map();
    for (const section of sections) {
      const prefix = section.dataset.prefix;
      const map = new Map();
      for (const el of section.querySelectorAll('[id]')) {
        const before = el.id;
        el.id = prefix + before;
        map.set(before, el.id);
        stats.ids++;
      }
      idMaps.set(section, map);
    }

    /** Path → link-map key. '' (the tree root) normalises to 'index'. */
    const pathToKey = (pathname) => {
      let p = pathname.replace(/^\/+|\/+$/g, '');
      if (base) {
        const b = base.replace(/^\/+/, '');
        if (p === b) p = '';
        else if (p.startsWith(b + '/')) p = p.slice(b.length + 1);
      }
      return p === '' ? 'index' : p;
    };

    // 2. Rewrite links.
    for (const section of sections) {
      const slug = section.dataset.slug;
      const idMap = idMaps.get(section);
      // This section's own URL, so relative hrefs resolve. Must be the
      // locale-qualified path: /en/ for the English landing page, not /.
      const pathKey = section.dataset.path;
      const selfPath = base + '/' + (pathKey === 'index' ? '' : pathKey + '/');
      const selfURL = new URL(selfPath, location.origin);

      for (const a of section.querySelectorAll('a[href]')) {
        const raw = a.getAttribute('href');
        if (!raw) continue;
        // External and non-http schemes are left exactly as authored.
        if (/^(https?:)?\/\//i.test(raw) || /^[a-z][a-z0-9+.-]*:/i.test(raw)) continue;

        // Same-page fragment: heading self-links and in-page references.
        if (raw.startsWith('#')) {
          const target = idMap.get(decodeURIComponent(raw.slice(1)));
          if (target) {
            a.setAttribute('href', '#' + encodeURIComponent(target));
            stats.rewritten++;
          }
          continue;
        }

        const url = raw.startsWith('/') ? new URL(raw, location.origin) : new URL(raw, selfURL);
        const entry = linkMap[decodeURIComponent(pathToKey(url.pathname))];
        if (entry) {
          const hash = url.hash ? decodeURIComponent(url.hash.slice(1)) : '';
          a.setAttribute('href', '#' + encodeURIComponent(hash ? entry.idPrefix + hash : entry.sectionId));
          stats.rewritten++;
        } else {
          // Not part of this PDF (a cross-locale or cross-site link). Keep it
          // working as a web link instead of leaving a dead relative href.
          const rest = base && url.pathname.startsWith(base) ? url.pathname.slice(base.length) : url.pathname;
          a.setAttribute('href', site + rest + url.hash);
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener');
          stats.unresolved.push({ from: slug, href: raw });
        }
      }
    }

    // Never inherit dark mode from localStorage — print.css assumes light.
    document.documentElement.dataset.theme = 'light';

    window.__printProtocol = Object.assign(stats, { ready: true });
  })();
</script>
