---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
// Vite ?raw import: inlined at bundle time, so it also works in the prerender
// build where import.meta.url points into dist/ and fs paths would break.
import versionRaw from '../../VERSION?raw';
import { pdfFileName } from '../pdf-name.mjs';

// Starlight sets `Astro.currentLocale` from the route's locale (undefined for
// the root/简体中文 tree, 'en' under /en/) — same check as Footer.astro.
const isEnglish = Astro.currentLocale === 'en';

// The PDFs are produced by `pnpm pdf` after the build and land in dist/ next to
// the pages. A build that does not run that step sets PUBLIC_PDF_DOWNLOAD=off, so
// the header does not offer a file that is not there. Same opt-out shape as
// PUBLIC_AI_ASSISTANT_ENDPOINT in AskAI.astro.
const enabled = (import.meta.env.PUBLIC_PDF_DOWNLOAD ?? 'on') !== 'off';

const version = versionRaw.trim();
// BASE_URL is Astro's normalised `base`: '/' locally, '/gateway-protocol/' or
// '/gateway-protocol/v<version>/' in CI. Strip the trailing slash so the join below
// produces exactly one, and the href stays correct under every base.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const file = pdfFileName(isEnglish ? 'en' : 'zh-CN', version);
const href = `${base}/${file}`;

const label = isEnglish ? 'Download PDF' : '下载 PDF';
const a11y = isEnglish
  ? `Download the complete protocol reference as a PDF (v${version})`
  : `下载完整通讯协议 PDF（v${version}）`;
---

{/* config.social — the cross-link to 《彼络物联网关 说明书》 */}
<Default />

{
  enabled && (
  <a class="pdf-link" {href} download={file} title={a11y} aria-label={a11y}>
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </svg>
    <span class="pdf-link-label">{label}</span>
  </a>
  )
}

<style>
  .pdf-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    line-height: 1;
    white-space: nowrap;
  }
  .pdf-link:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .pdf-link svg {
    flex: none;
  }

  /*
   * The header is tight: below 59em custom.css already hides `.site-title > span`
   * for the same reason. Collapse to icon-only over the same breakpoint so the two
   * degrade together. Visually hidden rather than `display: none` so the link keeps
   * its accessible name — same technique as the .site-title rule.
   */
  @media (max-width: 59em) {
    .pdf-link {
      padding: 0.3rem;
    }
    .pdf-link-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
  }

  /* Starlight also renders SocialIcons in the mobile menu drawer, where there is
     room for the full label. */
  :global(.mobile-preferences) .pdf-link {
    padding: 0.3rem 0.6rem;
  }
  :global(.mobile-preferences) .pdf-link-label {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip-path: none;
  }

  /* Site chrome, not document content. */
  @media print {
    .pdf-link {
      display: none;
    }
  }
</style>
